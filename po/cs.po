#: openexpress/auth/sso.py
msgid "Sign-In Page Not Working"
msgstr "Přihlašovací stránka nefunguje"

#: openexpress/auth/sso.py
msgid ""
"Try again, or sign in without this window: run this command in a terminal, "
"sign in in your web browser, then paste the address the browser shows at the "
"end."
msgstr ""
"Zkuste to znovu, nebo se přihlaste bez tohoto okna: spusťte tento příkaz v "
"terminálu, přihlaste se ve webovém prohlížeči a poté vložte adresu, kterou "
"prohlížeč na konci zobrazí."

#: openexpress/auth/sso.py openexpress/gui/device_page.py
#: openexpress/gui/netstatus_view.py openexpress/gui/updates_page.py
msgid "Try Again"
msgstr "Zkusit znovu"

#: openexpress/auth/sso.py
msgid "Sign in to Garmin"
msgstr "Přihlásit se ke Garminu"

#: openexpress/auth/sso.py
msgid "Sign-in cancelled or no SSO ticket received."
msgstr "Přihlášení bylo zrušeno nebo nebyl přijat přihlašovací token SSO."

#: openexpress/auth/sso.py
msgid "1. Open this URL in your browser:"
msgstr "1. Otevřete tuto adresu URL v prohlížeči:"

#: openexpress/auth/sso.py
msgid ""
"2. Sign in. Afterwards, copy the full URL from the browser's address bar\n"
"   (it contains “ticket=ST-…”). If the browser shows an error, the URL still "
"works."
msgstr ""
"2. Přihlaste se. Potom zkopírujte celou URL z adresního řádku prohlížeče\n"
"   (obsahuje „ticket=ST-…“). I když prohlížeč zobrazí chybu, URL lze použít."

#: openexpress/auth/sso.py
msgid "3. Paste the URL: "
msgstr "3. Vložte adresu URL: "

#: openexpress/auth/sso.py
msgid "The given URL has no ticket=ST-... parameter"
msgstr "Zadaná adresa URL neobsahuje parametr ticket=ST-..."

#. TRANSLATORS: shown in place of the signed-in Garmin account's name when it has no user
#. name and no e-mail address
#: openexpress/auth/store.py
msgid "(unknown account)"
msgstr "(neznámý účet)"

#: openexpress/auth/store.py openexpress/connect.py
msgid "Not signed in. Run: openexpress login"
msgstr "Nejste přihlášeni. Spusťte: openexpress login"

#: openexpress/auth/store.py
msgid "The saved sign-in is damaged; sign in again."
msgstr "Uložené přihlašovací údaje jsou poškozené. Přihlaste se znovu."

#: openexpress/background.py
msgid "Background sync was not allowed."
msgstr "Synchronizace na pozadí nebyla povolena."

#: openexpress/background.py
msgid "Starting at login was not allowed."
msgstr "Spouštění při přihlášení nebylo povoleno."

#: openexpress/background.py
msgid "Sync the device with Garmin Connect when it is connected."
msgstr "Po připojení zařízení jej synchronizovat s Garmin Connect."

#: openexpress/background.py
msgid "systemctl was not found; background sync needs systemd."
msgstr ""
"Příkaz systemctl nebyl nalezen; synchronizace na pozadí vyžaduje systemd."

#: openexpress/backup.py
#, python-brace-format
msgid ""
"Nothing was backed up: the device names a folder or file “{name}” that "
"cannot be used as a path on this computer."
msgstr ""
"Nic nebylo zálohováno: zařízení obsahuje složku nebo soubor „{name}“, jehož "
"název nelze na tomto počítači použít jako cestu."

#: openexpress/backup.py
#, python-brace-format
msgid ""
"{count} file was still being written by the device and is not in the backup. "
"Unplug the device and plug it in again, then make the backup again."
msgid_plural ""
"{count} files were still being written by the device and are not in the "
"backup. Unplug the device and plug it in again, then make the backup again."
msgstr[0] ""
"{count} soubor se v zařízení stále zapisoval a není v záloze. Odpojte "
"zařízení, znovu ho připojte a vytvořte novou zálohu."
msgstr[1] ""
"{count} soubory se v zařízení stále zapisovaly a nejsou v záloze. Odpojte "
"zařízení, znovu ho připojte a vytvořte novou zálohu."
msgstr[2] ""
"{count} souborů se v zařízení stále zapisovalo a nejsou v záloze. Odpojte "
"zařízení, znovu ho připojte a vytvořte novou zálohu."

#. TRANSLATORS: a step of a backup ("… · 120 of 1530")
#: openexpress/backup.py
msgid "Copying to the backup"
msgstr "Kopírování do zálohy"

