msgstr "v zařízení není dostatek místa pro Connect IQ"

#: openexpress/ciq.py
#, python-brace-format
msgid "the device does not accept {datatype}"
msgstr "zařízení nepřijímá datový typ {datatype}"

#: openexpress/ciq.py
msgid ""
"The Flatpak has no access to USB devices, so it cannot update apps on this "
"device."
msgstr ""
"Flatpak nemá přístup k zařízením USB, proto nemůže aktualizovat aplikace v "
"tomto zařízení."

#: openexpress/ciq.py
msgid ""
"The update waits in the queue in Garmin Connect and will be installed by the "
"phone or Garmin Express."
msgstr ""
"Aktualizace čeká ve frontě Garmin Connect a nainstaluje se prostřednictvím "
"telefonu nebo Garmin Express."

#: openexpress/ciq.py
msgid ""
"The update will be queued in Garmin Connect and installed by the phone or "
"Garmin Express."
msgstr ""
"Aktualizace bude zařazena do fronty Garmin Connect a nainstalována "
"prostřednictvím telefonu nebo Garmin Express."

#: openexpress/ciq.py
msgid ""
"The Flatpak has no access to USB devices, so it cannot install apps on this "
"device."
msgstr ""
"Flatpak nemá přístup k zařízením USB, proto nemůže do tohoto zařízení "
"instalovat aplikace."

#: openexpress/ciq.py
msgid ""
"The app waits in the queue in Garmin Connect and will be installed by the "
"phone or Garmin Express."
msgstr ""
"Aplikace čeká ve frontě Garmin Connect a nainstaluje se prostřednictvím "
"telefonu nebo Garmin Express."

#: openexpress/ciq.py
msgid ""
"The app will be queued in Garmin Connect and installed by the phone or "
"Garmin Express."
msgstr ""
"Aplikace bude zařazena do fronty Garmin Connect a nainstalována "
"prostřednictvím telefonu nebo Garmin Express."

#: openexpress/ciq.py
msgid ""
"The Flatpak has no access to USB devices, so it cannot remove apps from this "
"device."
msgstr ""
"Flatpak nemá přístup k zařízením USB, proto nemůže z tohoto zařízení "
"odebírat aplikace."

#: openexpress/ciq.py
msgid "Remove it on the phone, in the Connect IQ or Garmin Connect app."
msgstr "Odeberte ji v telefonu v aplikaci Connect IQ nebo Garmin Connect."

#: openexpress/ciq.py
#, python-brace-format
