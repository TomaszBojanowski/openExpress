#: openexpress/auth/sso.py
#, python-brace-format
msgid "Sign-In Page Not Working"
msgstr "La page de connexion ne fonctionne pas"

#: openexpress/auth/sso.py
#, python-brace-format
msgid ""
"Try again, or sign in without this window: run this command in a terminal, "
"sign in in your web browser, then paste the address the browser shows at the "
"end."
msgstr ""
"Réessayez, ou connectez-vous sans passer par cette fenêtre : exécutez cette "
"commande dans un terminal, connectez-vous via votre navigateur web, puis "
"collez l’adresse qui s’affiche dans le navigateur."

#: openexpress/auth/sso.py openexpress/gui/device_page.py
#: openexpress/gui/netstatus_view.py openexpress/gui/updates_page.py
#, python-brace-format
msgid "Try Again"
msgstr "Essayer à nouveau"

#: openexpress/auth/sso.py
#, fuzzy, python-brace-format
#| msgid "Sign in to Garmin"
msgid "Sign In to Garmin"
msgstr "Connectez-vous à Garmin"

#: openexpress/auth/sso.py
#, python-brace-format
msgid "Sign-in cancelled or no SSO ticket received."
msgstr "Connexion annulée ou aucun ticket SSO reçu."

#: openexpress/auth/sso.py
#, python-brace-format
msgid "1. Open this URL in your browser:"
msgstr "1. Ouvrez cette URL dans votre navigateur :"

#: openexpress/auth/sso.py
#, python-brace-format
msgid ""
"2. Sign in. Afterwards, copy the full URL from the browser's address bar\n"
"   (it contains “ticket=ST-…”). If the browser shows an error, the URL still "
"works."
msgstr ""
"2. Connectez-vous. Ensuite, copiez l'URL complète depuis la barre d'adresse "
"du navigateur\n"
"(elle contient « ticket=ST-… »). Si le navigateur affiche une erreur, l'URL "
"reste fonctionnelle."

#: openexpress/auth/sso.py
#, python-brace-format
msgid "3. Paste the URL: "
msgstr "3. Collez l’URL : "

#: openexpress/auth/sso.py
#, python-brace-format
msgid "The given URL has no ticket=ST-… parameter"
msgstr "L'URL fournie ne comporte pas de paramètre ticket=ST-...paramètre"

#. TRANSLATORS: shown in place of the signed-in Garmin account's name when it has no user
#. name and no e-mail address
#: openexpress/auth/store.py
#, python-brace-format
msgid "(unknown account)"
msgstr "(compte inconnu)"

#: openexpress/auth/store.py openexpress/connect.py
#, python-brace-format
msgid "Not signed in. Run: openexpress login"
msgstr "Non connecté. Exécutez : openexpress login"

#: openexpress/auth/store.py
#, python-brace-format
msgid "The saved sign-in is damaged; sign in again."
msgstr ""
"Les informations de connexion enregistrées sont endommagées ; reconnectez-"
"vous.Les informations de connexion enregistrées sont endommagées ; veuillez "
"vous reconnecter."

#. TRANSLATORS: said when the system could not be asked to keep the computer awake while
#. openExpress copies to the device
#: openexpress/awake.py
#, python-brace-format
msgid ""
"openExpress could not keep the computer from sleeping: keep it awake until "
"the copy has ended."
msgstr ""
"openExpress n’a pas réussi à empêcher l’ordinateur de se mettre en veille : "
"maintenez-le actif jusqu’à la fin de la copie."

#: openexpress/background.py
#, python-brace-format
msgid "Background sync was not allowed."
msgstr "La synchronisation en arrière-plan n’était pas autorisée."

#: openexpress/background.py
#, python-brace-format
msgid "Starting at login was not allowed."
msgstr "Le démarrage lors de la connexion n’était pas autorisé."

#: openexpress/background.py
#, python-brace-format
msgid "Sync the device with Garmin Connect when it is connected."
msgstr "Synchronisez l'appareil avec Garmin Connect lorsqu'il est connecté."

#. TRANSLATORS: why background sync could not be turned on in the Flatpak: the desktop's
#. portal has no Background service; "the version from source" is openExpress installed from
#. its source code, which runs in the background without the portal
#: openexpress/background.py
#, python-brace-format
msgid ""
"This desktop does not let Flatpak apps run in the background (its portal has "
"no Background service). Use the version from source to sync in the "
"background."
msgstr ""

#: openexpress/background.py
#, python-brace-format
msgid "systemctl was not found; background sync needs systemd."
msgstr ""
"systemctl est introuvable ; la synchronisation en arrière-plan nécessite "
"systemd.systemctl est introuvable ; la synchronisation en arrière-plan "
"nécessite systemd."

#: openexpress/backup.py
#, python-brace-format
msgid ""
"Nothing was backed up: the device names a folder or file “{name}” that "
"cannot be used as a path on this computer."
msgstr ""
"Rien n’a été sauvegardé : l’appareil désigne un dossier ou un fichier "
"« {name} » qui ne peut pas être utilisé comme chemin d’accès sur cet "
"ordinateur."

#. TRANSLATORS: after a backup (a message of the window and a line of the command line)
#: openexpress/backup.py
#, python-brace-format
msgid ""
"{count} file was still being written by the device and is not in the backup. "
"Unplug the device and plug it in again, then make the backup again."
msgid_plural ""
"{count} files were still being written by the device and are not in the "
"backup. Unplug the device and plug it in again, then make the backup again."
msgstr[0] ""
"{count} fichier était encore en cours d’écriture par l’appareil et ne figure "
"pas dans la sauvegarde. Débranchez l’appareil, rebranchez-le, puis effectuez "
"à nouveau la sauvegarde."
msgstr[1] ""
"{count} fichiers étaient encore en cours d’écriture par l’appareil et ne "
"figurent pas dans la sauvegarde. Débranchez l’appareil, rebranchez-le, puis "
"effectuez à nouveau la sauvegarde."

#. TRANSLATORS: a step of a backup ("… · 120 of 1530")
#: openexpress/backup.py
#, python-brace-format
msgid "Copying to the backup"
msgstr "Copie vers la sauvegarde"

