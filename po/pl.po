msgstr "Kolejka plików Connect"

#: openexpress/connect.py
#, python-brace-format
msgid "Downloading a file from Garmin Connect"
msgstr "Pobieranie pliku z Garmin Connect"

#. TRANSLATORS: name of a server request (telling Garmin Connect that a queued file was
#. received), shown before an error
#: openexpress/connect.py
#, python-brace-format
msgid "Receipt acknowledgement"
msgstr "Potwierdzenie odbioru"

#. TRANSLATORS: an error: Garmin's server answered something openExpress cannot read; {what}:
#. the name of the request
#: openexpress/connect.py
#, python-brace-format
msgid ""
"{what}: Garmin's server gave an answer openExpress does not understand; try "
"again later"
msgstr ""
"{what}: serwer Garmina odpowiedział w sposób, którego openExpress nie "
"rozumie; spróbuj ponownie później"

#: openexpress/course_gpx.py openexpress/music.py openexpress/ownmaps.py
#, python-brace-format
msgid "Not found: {path}"
msgstr "Nie znaleziono: {path}"

#. TRANSLATORS: a GPX file chosen to be copied to the device as a course is too large;
#. {size} and {limit}: sizes such as "31.2 MB"
#: openexpress/course_gpx.py
#, python-brace-format
msgid "{file} is too large for a course: {size}, at most {limit}."
msgstr "{file} jest za duży na kurs: {size}, najwyżej {limit}."

#. TRANSLATORS: a GPX file declares a document type (<!DOCTYPE …>) or entities, which
#. could make a parser expand them or read other files: it is not read at all
#: openexpress/course_gpx.py
#, python-brace-format
msgid ""
"{file} is not read: it declares a document type, which a GPX file has no "
"need of."
msgstr ""
"{file} nie zostanie odczytany: deklaruje typ dokumentu, którego plik GPX nie "
"potrzebuje."

#. TRANSLATORS: a point of a GPX file has a latitude or longitude out of range, or none
#: openexpress/course_gpx.py
#, python-brace-format
msgid "{file} has a point with an impossible position."
msgstr "{file} ma punkt o niemożliwym położeniu."

#. TRANSLATORS: a file chosen to be copied to the device as a course is not a GPX file
#: openexpress/course_gpx.py
#, python-brace-format
msgid "{file} is not a GPX file."
msgstr "{file} nie jest plikiem GPX."

#. TRANSLATORS: a GPX file has nothing the device could navigate by
#: openexpress/course_gpx.py
#, python-brace-format
msgid "{file} has no track, route or waypoint."
msgstr "{file} nie ma śladu, trasy ani punktu."

#. TRANSLATORS: the course's name cannot be written into this GPX file (its text is
#. written in UTF-16 or UTF-32); the file can be copied with the name it has
#: openexpress/course_gpx.py
#, python-brace-format
msgid ""
"The name of the course cannot be changed in {file}; copy it with the name it "
"has."
msgstr ""
"W pliku {file} nie da się zmienić nazwy kursu; skopiuj go z nazwą, którą ma."

#. TRANSLATORS: `courses add FILE --name NAME` for a GPX file of waypoints only
#: openexpress/courses.py
#, python-brace-format
msgid ""
"{file} has only waypoints: no course is made of it, so it takes no course "
"name."
msgstr ""
"{file} zawiera tylko punkty: urządzenie nie zrobi z niego kursu, więc nie "
"można nadać mu nazwy kursu."

#. TRANSLATORS: `courses add FILE --name NAME` for a GPX file of several tracks and routes,
#. each of which the device makes a course of, with the name it has
#: openexpress/courses.py
#, python-brace-format
msgid ""
"{file} makes {count} course; only a file with one track or route takes a "
"course name."
msgid_plural ""
"{file} makes {count} courses; only a file with one track or route takes a "
"course name."
msgstr[0] ""
"Z pliku {file} urządzenie zrobi {count} kurs; nazwę kursu można nadać tylko "
"plikowi z jednym śladem lub trasą."
msgstr[1] ""
"Z pliku {file} urządzenie zrobi {count} kursy; nazwę kursu można nadać tylko "
"plikowi z jednym śladem lub trasą."
msgstr[2] ""
"Z pliku {file} urządzenie zrobi {count} kursów; nazwę kursu można nadać "
"tylko plikowi z jednym śladem lub trasą."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "A file named {name} is already on the device; nothing is overwritten."
msgstr ""
"Plik o nazwie {name} jest już na urządzeniu; nic nie zostanie nadpisane."

#: openexpress/courses.py
#, python-brace-format
msgid "The device makes the course when you unplug the cable."
msgid_plural "The device makes {count} courses when you unplug the cable."
msgstr[0] "Urządzenie utworzy kurs po odłączeniu kabla."
msgstr[1] "Urządzenie utworzy {count} kursy po odłączeniu kabla."
msgstr[2] "Urządzenie utworzy {count} kursów po odłączeniu kabla."

#: openexpress/courses.py
#, python-brace-format
msgid ""
"Garmin devices join the points of a route with straight lines, not roads. "
"For a course along roads, export a track instead of a route."
msgstr ""
"Urządzenia Garmina łączą punkty trasy prostymi odcinkami, nie drogami. Jeśli "
"chcesz kurs po drogach, wyeksportuj ślad zamiast trasy."

#: openexpress/courses.py
#, python-brace-format
msgid "Garmin devices save waypoints as saved locations."
msgstr "Urządzenia Garmina zapisują punkty jako zapisane lokalizacje."

#. TRANSLATORS: a device that takes GPX files in a folder of its own ({folder}, e.g. GPX),
#. not in Garmin/NewFiles, where openExpress copies them
#: openexpress/courses.py
#, python-brace-format
msgid ""
"This device takes GPX files in its own folder {folder}, where openExpress "
"does not copy them."
msgstr ""
"To urządzenie przyjmuje pliki GPX we własnym folderze {folder}, do którego "
"openExpress ich nie kopiuje."

#. TRANSLATORS: a device that does not take GPX files in Garmin/NewFiles
#: openexpress/courses.py
#, python-brace-format
msgid "This device does not make courses of GPX files."
msgstr "To urządzenie nie tworzy kursów z plików GPX."

#. TRANSLATORS: {folder}: a folder the device declares, such as Garmin/NewFiles
#: openexpress/courses.py
#, python-brace-format
msgid "The device has no folder {folder}."
msgstr "Na urządzeniu nie ma folderu {folder}."

#. TRANSLATORS: copying a map file to the device failed; {path}: the file's path on the
#. device
#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "Writing {path} failed."
msgstr "Zapis {path} się nie powiódł."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "{name} is no longer on the device."
msgstr "Pliku {name} nie ma już na urządzeniu."

#. TRANSLATORS: a course's file or a waiting GPX file chosen to be removed
#: openexpress/courses.py
#, python-brace-format
msgid "{name} has changed since the list was shown, so it is not removed."
msgstr ""
"Plik {name} zmienił się od wyświetlenia listy, więc nie zostanie usunięty."

#. TRANSLATORS: what was chosen to be removed is not a course's file or a waiting GPX
#. file of the device's folders
#: openexpress/courses.py
#, python-brace-format
msgid "{name} is not the file of a course, so it is not removed."
msgstr "{name} nie jest plikiem kursu, więc nie zostanie usunięty."

#: openexpress/courses.py
#, python-brace-format
msgid "The device has not made a course of it yet."
msgstr "Urządzenie nie zrobiło jeszcze z niego kursu."

#: openexpress/courses.py
#, python-brace-format
msgid "The device keeps no other copy of it."
msgstr "Urządzenie nie ma innej kopii tego kursu."

#: openexpress/courses.py
#, python-brace-format
msgid "The device keeps no other copy of it; Garmin Connect can send it again."
msgstr ""
"Urządzenie nie ma innej kopii tego kursu; Garmin Connect może wysłać go "
"ponownie."

#: openexpress/courses.py
#, python-brace-format
msgid ""
"openExpress did not copy this course and it did not come from Garmin "
"Connect. The device keeps no other copy of it."
msgstr ""
"openExpress nie skopiował tego kursu i nie pochodzi on z Garmin Connect. "
"Urządzenie nie ma innej kopii tego kursu."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "{path} is still on the device."
msgstr "Plik {path} nadal jest na urządzeniu."

#. TRANSLATORS: the name in the application menu of openExpress installed from its source code
#. (not the Flatpak), so that it can be told apart from the Flatpak's "openExpress"; keep the
#. name openExpress as it is
#: openexpress/desktop.py
#, python-brace-format
msgid "openExpress (source)"
msgstr "openExpress (ze źródeł)"

#. TRANSLATORS: name of the hidden desktop entry that syncs in the background when the device is
#. connected
#: openexpress/desktop.py
#, python-brace-format
msgid "openExpress (background)"
msgstr "openExpress (w tle)"

#. TRANSLATORS: generic name of the app in application menus (GenericName in the desktop file): a
#. tool that syncs Garmin devices
#: openexpress/desktop.py
#, python-brace-format
msgid "Garmin Device Sync"
msgstr "Synchronizacja urządzeń Garmin"

#: openexpress/desktop.py
#, python-brace-format
msgid "Sync, updates and maps for Garmin devices"
msgstr "Synchronizacja, aktualizacje i mapy dla urządzeń Garmin"

#. TRANSLATORS: search keywords for the application menu; keep the ";" separators and the ending ";"
#: openexpress/desktop.py
#, python-brace-format
msgid "Garmin;Fenix;Connect;sync;"
msgstr "Garmin;Fenix;Connect;sync;synchronizacja;zegarek;"

#. TRANSLATORS: after the words of a write or a new folder that failed on the device (e.g.
#. "Cannot write GARMIN/x.fit: Could not send object info.")
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "The device refused it; a device report helps find out why."
msgstr "Urządzenie odmówiło; raport o urządzeniu pomoże ustalić dlaczego."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "the Flatpak is missing the permission to copy files to the device"
msgstr "Flatpakowi brakuje uprawnienia do kopiowania plików na urządzenie"

#. TRANSLATORS: error, after "Cannot write {path}: ": a copy to the device stopped at
#. its time limit ({seconds}: a number of seconds, e.g. 21600)
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "timed out after {seconds} seconds"
msgstr "przekroczono limit czasu ({seconds} s)"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "flatpak-spawn is not available"
msgstr "flatpak-spawn jest niedostępny"

#. TRANSLATORS: error: the contents of a folder on the device cannot be read ({path}: the
#. folder)
#: openexpress/device/gio_storage.py openexpress/device/storage.py
#, python-brace-format
msgid "Cannot list {path}"
msgstr "Nie można wyświetlić zawartości {path}"

#. TRANSLATORS: error: a file on the device cannot be deleted ({path}: the file)
#: openexpress/device/gio_storage.py openexpress/device/storage.py
#, python-brace-format
msgid "Cannot delete {path}"
msgstr "Nie można usunąć {path}"

#: openexpress/device/gio_storage.py openexpress/device/storage.py
#, python-brace-format
msgid "Cannot create the folder {path}"
msgstr "Nie można utworzyć folderu {path}"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "Cannot read the space on the device"
msgstr "Nie można odczytać miejsca na urządzeniu"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "Cannot mount the device"
msgstr "Nie można zamontować urządzenia"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "The device is not mounted."
msgstr "Urządzenie nie jest zamontowane."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The drive is not mounted any more. If it was ejected, you can unplug the "
"cable."
msgstr ""
"Dysk nie jest już zamontowany. Jeśli został wysunięty, możesz odłączyć kabel."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "Cannot eject the device"
msgstr "Nie można wysunąć urządzenia"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The device is ejected. Unplug the cable and leave the device unplugged so it "
"can install the update."
msgstr ""
"Urządzenie zostało wysunięte. Odłącz kabel i zostaw urządzenie odłączone, "
"aby mogło zainstalować aktualizację."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "The device is ejected. You can unplug the cable."
msgstr "Urządzenie zostało wysunięte. Możesz odłączyć kabel."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"Do not unplug the cable yet: the device may not see the files from Garmin "
"Connect. Close any program that uses the drive and try again, or eject it in "
"the file manager."
msgstr ""
"Nie odłączaj jeszcze kabla: urządzenie może nie zobaczyć plików z Garmin "
"Connect. Zamknij programy, które używają dysku, i spróbuj ponownie albo "
"wysuń go w menedżerze plików."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"Do not unplug the cable yet: the device may not see the files from Garmin "
"Connect. Close any program that uses the drive and eject it in the file "
"manager."
msgstr ""
"Nie odłączaj jeszcze kabla: urządzenie może nie zobaczyć plików z Garmin "
"Connect. Zamknij programy, które używają dysku, i wysuń go w menedżerze "
"plików."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"Do not unplug the cable yet: the device may not see the update. Close any "
"program that uses the drive and try again, or eject it in the file manager."
msgstr ""
"Nie odłączaj jeszcze kabla: urządzenie może nie zobaczyć aktualizacji. "
"Zamknij programy, które używają dysku, i spróbuj ponownie albo wysuń go "
"w menedżerze plików."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"Do not unplug the cable yet: the device may not see the update. Close any "
"program that uses the drive and eject it in the file manager."
msgstr ""
"Nie odłączaj jeszcze kabla: urządzenie może nie zobaczyć aktualizacji. "
"Zamknij programy, które używają dysku, i wysuń go w menedżerze plików."

#. TRANSLATORS: title while the only Garmin device on USB is one openExpress cannot use: it
#. connects neither over MTP nor as a USB drive
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "Device Not Supported"
msgstr "Nieobsługiwane urządzenie"

#. TRANSLATORS: on the start page, after the name of a Garmin device openExpress cannot use
#. (e.g. "Garmin USB inReach · Unsupported connection"); a line of a caption, so sentence
#. case and no full stop
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "Unsupported connection"
msgstr "nieobsługiwane połączenie"

#. TRANSLATORS: in the words about a Garmin device openExpress cannot use, after
#. "Connected:", when the device gives USB no name
#: openexpress/device/gio_storage.py
#, python-brace-format
msgctxt "in a sentence"
msgid "Garmin device"
msgstr "urządzenie Garmin"

#. TRANSLATORS: the words of the window while the only Garmin device on USB is one
#. openExpress cannot use; {name}: the name it gives USB (e.g. "Garmin USB inReach");
#. {id}: its USB ID (e.g. "091e:0b89"); {item}: the item of the main menu, "Report a
#. Device or Problem…" in your language (put your language's quotation marks around it)
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"openExpress works with devices that connect as a media device (MTP) or a USB "
"drive. This one uses a different connection. Connected: {name} (USB {id}). "
"To report it, choose “{item}” in the main menu."
msgstr ""
"openExpress działa z urządzeniami, które łączą się jako urządzenie "
"multimedialne (MTP) lub dysk USB. To urządzenie używa innego połączenia. "
"Podłączone: {name} (USB {id}). Aby to zgłosić, wybierz „{item}” w menu "
"głównym."

#: openexpress/device/gio_storage.py openexpress/gui/app.py
#: openexpress/gui/window_tasks.py
#, python-brace-format
msgid "Report a Device or Problem…"
msgstr "Zgłoś urządzenie lub problem…"

#. TRANSLATORS: the same on the command line; "openexpress report" is a command, not to be
#. translated
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"openExpress works with devices that connect as a media device (MTP) or a USB "
"drive. This one uses a different connection. Connected: {name} (USB {id}). "
"To report it, run openexpress report."
msgstr ""
"openExpress działa z urządzeniami, które łączą się jako urządzenie "
"multimedialne (MTP) lub dysk USB. To urządzenie używa innego połączenia. "
"Podłączone: {name} (USB {id}). Aby to zgłosić, uruchom openexpress report."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The device is connected in mass storage mode (as a USB drive): apps, maps "
"and music are not supported in this mode."
msgstr ""
"Urządzenie jest podłączone w trybie pamięci masowej (jako dysk USB): "
"aplikacje, mapy i muzyka nie są w tym trybie obsługiwane."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"After it was ejected, the watch switched to its Garmin USB mode. Unplug the "
"cable and leave the device unplugged so it can install the update."
msgstr ""
"Po wysunięciu zegarek przeszedł w tryb Garmin USB. Odłącz kabel i zostaw "
"urządzenie odłączone, aby mogło zainstalować aktualizację."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"After it was ejected, the watch switched to its Garmin USB mode, which "
"openExpress does not use. Unplug the cable and plug it in again."
msgstr ""
"Po wysunięciu zegarek przeszedł w tryb Garmin USB, z którego openExpress nie "
"korzysta. Odłącz kabel i podłącz go ponownie."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The Garmin device is connected, but its drive is not mounted. Open it in the "
"file manager, or unplug the cable and plug it in again."
msgstr ""
"Urządzenie Garmin jest podłączone, ale dysk nie jest zamontowany. Otwórz go "
"w menedżerze plików albo odłącz i podłącz kabel ponownie."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The Garmin device is connected as a USB drive, but this version (Flatpak) "
"has no access to /run/media, where the system mounted it."
msgstr ""
"Urządzenie Garmin jest podłączone jako dysk USB, ale ta wersja (Flatpak) nie "
"ma dostępu do /run/media, gdzie system je zamontował."

#. TRANSLATORS: added once the wait for a device on USB ran out: this user may not open
#. it (over SSH, another user's session, or no udev rule gives access to it)
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"This user has no access to the device on USB. Run openExpress as the user "
"logged in at this computer's screen, not over SSH, or give this user access "
"to the device (a udev rule)."
msgstr ""
"Ten użytkownik nie ma dostępu do urządzenia podłączonego przez USB. Uruchom "
"openExpress jako użytkownik zalogowany przy ekranie tego komputera, a nie "
"przez SSH, albo nadaj temu użytkownikowi dostęp do urządzenia (reguła udev)."

#. TRANSLATORS: the same as "This user has no access to the device on USB. …", on the
#. command line; {node} is a path such as /dev/bus/usb/001/009, not to be translated
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"This user has no access to the device on USB ({node}). Run openExpress as "
"the user logged in at this computer's screen, not over SSH, or give this "
"user access to the device (a udev rule)."
msgstr ""
"Ten użytkownik nie ma dostępu do urządzenia podłączonego przez USB ({node}). "
"Uruchom openExpress jako użytkownik zalogowany przy ekranie tego komputera, "
"a nie przez SSH, albo nadaj temu użytkownikowi dostęp do urządzenia (reguła "
"udev)."

#. TRANSLATORS: added once the wait for a device on USB ran out: KDE's MTP service may hold
#. it; "kquitapp6 kiod6" is a command, not to be translated
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"KDE's MTP service may be holding the device: it keeps it after Dolphin is "
"closed and takes it back when the cable is plugged in again. Close Dolphin "
"and run kquitapp6 kiod6, then unplug the cable and plug it in again."
msgstr ""
"Urządzenie może zajmować usługa MTP w KDE: trzyma je także po zamknięciu "
"Dolphina i bierze z powrotem po ponownym podłączeniu kabla. Zamknij Dolphina "
"i uruchom kquitapp6 kiod6, a potem odłącz kabel i podłącz go ponownie."

#. TRANSLATORS: the device on USB but not offered, when what keeps it from openExpress is
#. known and said in the next sentence
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "The Garmin device is connected, but it does not offer its files."
msgstr "Urządzenie Garmin jest podłączone, ale nie udostępnia plików."

#. TRANSLATORS: title while a Garmin device is on USB and gvfs has no MTP support
#: openexpress/device/gio_storage.py
#, python-brace-format
msgid "No MTP Support in the System (gvfs-mtp)"
msgstr "Brak obsługi MTP w systemie (gvfs-mtp)"

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"openExpress reads the device over MTP through gvfs, and gvfs on this system "
"has no MTP support. Install it (Fedora: sudo dnf install gvfs-mtp; Arch: "
"sudo pacman -S gvfs-mtp; Debian and Ubuntu: sudo apt install gvfs-backends), "
"log out and back in, then plug the device in again."
msgstr ""
"openExpress odczytuje urządzenie przez MTP za pomocą gvfs, a w tym systemie "
"gvfs nie obsługuje MTP. Zainstaluj tę obsługę (Fedora: sudo dnf install gvfs-"
"mtp; Arch: sudo pacman -S gvfs-mtp; Debian i Ubuntu: sudo apt install gvfs-"
"backends), wyloguj się i zaloguj ponownie, a potem podłącz urządzenie "
"jeszcze raz."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The device is still starting. Wait until it shows its usual screen, or "
"unplug it and plug it in again."
msgstr ""
"Urządzenie nadal się uruchamia. Poczekaj, aż pokaże zwykły ekran, albo "
"odłącz je i podłącz ponownie."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"The Garmin device is connected, but it does not offer its files. Check its "
"screen: if it is locked with a PIN or asks something, unlock it or confirm."
msgstr ""
"Urządzenie Garmin jest podłączone, ale nie udostępnia plików. Sprawdź jego "
"ekran: jeśli jest zablokowane kodem PIN albo o coś pyta, odblokuj je lub "
"potwierdź."

#: openexpress/device/gio_storage.py
#, python-brace-format
msgid ""
"No Garmin device (MTP) found. Connect the device with a USB cable and unlock "
"it if it asks to allow the connection."
msgstr ""
"Nie znaleziono urządzenia Garmin (MTP). Podłącz urządzenie kablem USB "
"i odblokuj je, jeśli poprosi o zezwolenie na połączenie."

