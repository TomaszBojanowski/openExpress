#: openexpress/device/gio_storage.py:1542
#, python-brace-format
msgid ""
"openExpress works with devices that connect as a media device (MTP) or a USB "
"drive. This one uses a different connection. Connected: {name} (USB {id}). "
"To report it, run openexpress report."
msgstr ""
"openExpress działa z urządzeniami, które łączą się jako urządzenie "
