#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Copy and Remove"
msgstr "Skopiuj i usuń"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"{count} memory dump ({size}) will be copied to this computer and then "
"removed from the device."
msgid_plural ""
"{count} memory dumps ({size}) will be copied to this computer and then "
"removed from the device."
msgstr[0] ""
"{count} zrzut pamięci ({size}) zostanie skopiowany na ten komputer, a potem "
"usunięty z urządzenia."
msgstr[1] ""
"{count} zrzuty pamięci ({size}) zostaną skopiowane na ten komputer, a potem "
"usunięte z urządzenia."
msgstr[2] ""
"{count} zrzutów pamięci ({size}) zostanie skopiowanych na ten komputer, "
"a potem usuniętych z urządzenia."

#. TRANSLATORS: {limit} is the most the copies of removed dumps may take, "100 MB"
#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"{count} memory dump ({size}) will be removed from the device without a copy, "
"as the copies would not fit in {limit}."
msgid_plural ""
"{count} memory dumps ({size}) will be removed from the device without a "
"copy, as the copies would not fit in {limit}."
msgstr[0] ""
"{count} zrzut pamięci ({size}) zostanie usunięty z urządzenia bez kopii, bo "
"kopie nie zmieściłyby się w {limit}."
msgstr[1] ""
"{count} zrzuty pamięci ({size}) zostaną usunięte z urządzenia bez kopii, bo "
"kopie nie zmieściłyby się w {limit}."
msgstr[2] ""
"{count} zrzutów pamięci ({size}) zostanie usuniętych z urządzenia bez kopii, "
"bo kopie nie zmieściłyby się w {limit}."

#. TRANSLATORS: the first part of the confirmation when some dumps are copied first and
#. some are too large; "{copied part}, {not copied part}." follows
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} memory dump ({size}) will be removed from the device:"
msgid_plural "{count} memory dumps ({size}) will be removed from the device:"
msgstr[0] "Z urządzenia zostanie usunięty {count} zrzut pamięci ({size}):"
msgstr[1] "Z urządzenia zostaną usunięte {count} zrzuty pamięci ({size}):"
msgstr[2] "Z urządzenia zostanie usuniętych {count} zrzutów pamięci ({size}):"

#. TRANSLATORS: a part of the confirmation: how many dumps are copied first, e.g.
#. "2 (75.3 MB) after a copy on this computer"
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} ({size}) after a copy on this computer"
msgid_plural "{count} ({size}) after a copy on this computer"
msgstr[0] "{count} ({size}) po skopiowaniu na ten komputer"
msgstr[1] "{count} ({size}) po skopiowaniu na ten komputer"
msgstr[2] "{count} ({size}) po skopiowaniu na ten komputer"

#. TRANSLATORS: a part of the confirmation: how many dumps are removed without a copy
#. TRANSLATORS: {limit} is the most the copies of removed dumps may take, "100 MB"
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} ({size}) without a copy, as the copies would not fit in {limit}"
msgid_plural ""
"{count} ({size}) without a copy, as the copies would not fit in {limit}"
msgstr[0] "{count} ({size}) bez kopii, bo kopie nie zmieściłyby się w {limit}"
msgstr[1] "{count} ({size}) bez kopii, bo kopie nie zmieściłyby się w {limit}"
msgstr[2] "{count} ({size}) bez kopii, bo kopie nie zmieściłyby się w {limit}"

#. TRANSLATORS: in the question before older memory dumps are removed: only the dumps go;
#. the error logs, from which the crashes are counted, stay
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "The error logs stay on the device: the crashes are still counted."
msgstr "Dzienniki błędów zostają na urządzeniu: awarie są nadal liczone."

#. TRANSLATORS: in the question before older memory dumps are removed, when some of them
#. are removed without a copy on this computer: nothing is left that could be sent to
#. Garmin (e.g. its support) later
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "A dump removed without a copy cannot be sent to Garmin later."
msgstr "Zrzutu usuniętego bez kopii nie da się później wysłać do Garmina."

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "The newest dump stays on the device."
msgstr "Najnowszy zrzut zostaje na urządzeniu."

#. TRANSLATORS: why a removal from the device did not go to its end
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "the device stopped responding"
msgstr "urządzenie przestało odpowiadać"

#. TRANSLATORS: why a removal from the device did not go to its end, or was not counted
#. after it
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "the device could not be read again after the removal"
msgstr "po usunięciu nie udało się ponownie odczytać urządzenia"

#. TRANSLATORS: heading of the message when the device was unplugged or opened again
#. while a confirmation of the page Device Status was open
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Nothing Removed"
msgstr "Nic nie usunięto"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"The device was unplugged or plugged in again while the confirmation was "
"open. Check the list again."
msgstr ""
"Gdy pytanie było otwarte, urządzenie odłączono albo podłączono ponownie. "
"Sprawdź listę jeszcze raz."

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} memory dump removed, {size} freed"
msgid_plural "{count} memory dumps removed, {size} freed"
msgstr[0] "Usunięto {count} zrzut pamięci, zwolniono {size}"
msgstr[1] "Usunięto {count} zrzuty pamięci, zwolniono {size}"
msgstr[2] "Usunięto {count} zrzutów pamięci, zwolniono {size}"

#. TRANSLATORS: while the older memory dumps are copied and removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Removing the Memory Dumps…"
msgstr "Usuwanie zrzutów pamięci…"

#. TRANSLATORS: heading of the error when the older memory dumps were not removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Memory Dumps Not Removed"
msgstr "Nie usunięto zrzutów pamięci"

#. TRANSLATORS: heading of the confirmation before the older memory dumps are removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Remove Older Memory Dumps?"
msgstr "Usunąć starsze zrzuty pamięci?"

#. TRANSLATORS: after the file of an update the device did not install was removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Update file removed, {size} freed"
msgstr "Usunięto plik aktualizacji, zwolniono {size}"

#. TRANSLATORS: while the file of an update the device did not install is removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Removing the Update File…"
msgstr "Usuwanie pliku aktualizacji…"

#. TRANSLATORS: heading of the error when the file of an update the device
#. did not install was not removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Update File Not Removed"
msgstr "Nie usunięto pliku aktualizacji"

#. TRANSLATORS: heading of the confirmation before the file of an update the device
#. did not install is removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Remove the Update File?"
msgstr "Usunąć plik aktualizacji?"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"The file of {name} {version} ({size}) will be removed from the device; the "
"Updates page will offer the update again."
msgstr ""
"Plik {name} {version} ({size}) zostanie usunięty z urządzenia; strona "
"Aktualizacje znów zaproponuje tę aktualizację."

#. TRANSLATORS: why a removal from the device did not go to its end
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "the device was unplugged"
msgstr "urządzenie zostało odłączone"

#. TRANSLATORS: in the message when a removal from the device stopped, or was not
#. counted again, after files were removed; {done} tells what was removed, {why} why
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{done}. Then {why}."
msgstr "{done}. Potem {why}."

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"The device did not remove {count} of the files; the others were removed."
msgid_plural ""
"The device did not remove {count} of the files; the others were removed."
msgstr[0] "Urządzenie nie usunęło {count} z plików; pozostałe usunięto."
msgstr[1] "Urządzenie nie usunęło {count} z plików; pozostałe usunięto."
msgstr[2] "Urządzenie nie usunęło {count} z plików; pozostałe usunięto."

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "The device did not remove the file."
msgid_plural "The device did not remove the {count} files."
msgstr[0] "Urządzenie nie usunęło pliku."
msgstr[1] "Urządzenie nie usunęło {count} plików."
msgstr[2] "Urządzenie nie usunęło {count} plików."

#. TRANSLATORS: after Copy and Remove, the memory dumps left on the device because
#. their copy on this computer failed; their names follow
#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"{count} memory dump was not removed, as its copy on this computer failed."
msgid_plural ""
"{count} memory dumps were not removed, as their copies on this computer "
"failed."
msgstr[0] ""
"{count} zrzut pamięci nie został usunięty, bo nie udało się skopiować go na "
"ten komputer."
msgstr[1] ""
"{count} zrzuty pamięci nie zostały usunięte, bo nie udało się skopiować ich "
"na ten komputer."
msgstr[2] ""
"{count} zrzutów pamięci nie zostało usuniętych, bo nie udało się skopiować "
"ich na ten komputer."

#. TRANSLATORS: heading of the message when a removal from the device stopped, or was
#. not counted again, after files were removed
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Removal Not Finished"
msgstr "Nie dokończono usuwania"

#. TRANSLATORS: heading of the message when the device did not remove every file
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Not All Files Removed"
msgstr "Nie wszystkie pliki usunięto"

#. TRANSLATORS: toast after Remove on the page Device Status when the files were removed
#. by something else meanwhile
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Nothing removed: the files were no longer on the device"
msgstr "Nic nie usunięto: tych plików nie było już na urządzeniu"

#. TRANSLATORS: subtitle of "Copies on This Computer" when none was made
#: openexpress/gui/status_page.py
#, python-brace-format
msgctxt "copies"
msgid "None yet"
msgstr "Jeszcze żadnej"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} copy"
msgid_plural "{count} copies"
msgstr[0] "{count} kopia"
msgstr[1] "{count} kopie"
msgstr[2] "{count} kopii"

#. TRANSLATORS: in the subtitle of "Copies on This Computer": when the last was made
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "the last {when}"
msgstr "ostatnia {when}"

#. TRANSLATORS: group of the page Device Status
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Diagnostic Files"
msgstr "Pliki diagnostyczne"

#. TRANSLATORS: row of the page Device Status: the copies of the diagnostic files kept here
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Copies on This Computer"
msgstr "Kopie na tym komputerze"

#. TRANSLATORS: button of "Copies on This Computer": opens the folder of the copies in
#. the file manager; short, for a narrow window
#: openexpress/gui/status_page.py
#, python-brace-format
msgctxt "open the folder of the copies"
msgid "Open"
msgstr "Otwórz"

#. TRANSLATORS: the full name of the button that opens the folder of the copies
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Open Folder"
msgstr "Otwórz folder"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Memory Dumps"
msgstr "Zrzuty pamięci"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Crash Logs"
msgstr "Dzienniki awarii"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"Hidden from the file manager: while they are copied, the device disappears "
