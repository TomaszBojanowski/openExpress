#, python-brace-format
msgid "The device is starting. Try again in a moment."
msgstr "Urządzenie się uruchamia. Spróbuj ponownie za chwilę."

#: openexpress/device/gio_storage.py
#, ignore-reused, python-brace-format
msgid "The device is starting…"
msgstr "Urządzenie się uruchamia…"

#: openexpress/device/gio_storage.py
#, python-brace-format
