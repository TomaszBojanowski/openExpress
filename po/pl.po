#: openexpress/auth/sso.py
#, python-brace-format
msgid "Sign-In Page Not Working"
msgstr "Strona logowania nie działa"

#: openexpress/auth/sso.py
#, python-brace-format
msgid ""
"Try again, or sign in without this window: run this command in a terminal, "
"sign in in your web browser, then paste the address the browser shows at the "
"end."
msgstr ""
"Spróbuj ponownie albo zaloguj się bez tego okna: uruchom to polecenie "
"w terminalu, zaloguj się w przeglądarce, a potem wklej adres, który "
"przeglądarka pokaże na końcu."

#: openexpress/auth/sso.py openexpress/gui/activities_since.py
#: openexpress/gui/device_page.py openexpress/gui/netstatus_view.py
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "Try Again"
msgstr "Spróbuj ponownie"

#: openexpress/auth/sso.py
#, python-brace-format
msgid "Sign In to Garmin"
msgstr "Zaloguj się do Garmina"

#: openexpress/auth/sso.py
#, python-brace-format
msgid "Sign-in cancelled or no SSO ticket received."
msgstr "Anulowano logowanie lub nie otrzymano biletu SSO."

#: openexpress/auth/sso.py
#, python-brace-format
msgid "1. Open this URL in your browser:"
msgstr "1. Otwórz ten adres URL w przeglądarce:"

#: openexpress/auth/sso.py
#, python-brace-format
msgid ""
"2. Sign in. Afterwards, copy the full URL from the browser's address bar\n"
"   (it contains “ticket=ST-…”). If the browser shows an error, the URL still "
"works."
msgstr ""
"2. Zaloguj się. Następnie skopiuj pełny adres URL z paska adresu "
"przeglądarki\n"
"   (zawiera „ticket=ST-…”). Jeśli przeglądarka pokaże błąd, adres URL nadal "
"działa."

#: openexpress/auth/sso.py
#, python-brace-format
msgid "3. Paste the URL: "
msgstr "3. Wklej adres URL: "

#: openexpress/auth/sso.py
#, ignore-end-stop, python-brace-format
msgid "The given URL has no ticket=ST-… parameter"
msgstr "Podany adres URL nie zawiera parametru ticket=ST-…"

#. TRANSLATORS: shown in place of the signed-in Garmin account's name when it has no user
#. name and no e-mail address
#: openexpress/auth/store.py
#, python-brace-format
msgid "(unknown account)"
msgstr "(nieznane konto)"

#: openexpress/auth/store.py openexpress/connect.py
#, python-brace-format
msgid "Not signed in. Run: openexpress login"
msgstr "Nie zalogowano. Uruchom: openexpress login"

#: openexpress/auth/store.py
#, python-brace-format
msgid "The saved sign-in is damaged; sign in again."
msgstr "Zapisane logowanie jest uszkodzone; zaloguj się ponownie."

#. TRANSLATORS: said when the system could not be asked to keep the computer awake while
#. openExpress copies to the device
#: openexpress/awake.py
#, python-brace-format
msgid ""
"openExpress could not keep the computer from sleeping: keep it awake until "
"the copy has ended."
msgstr ""
"openExpress nie mógł zablokować uśpienia komputera: nie usypiaj go do końca "
"kopiowania."

#: openexpress/background.py
#, python-brace-format
msgid "Background sync was not allowed."
msgstr "Nie zezwolono na synchronizację w tle."

#: openexpress/background.py
#, python-brace-format
msgid "Starting at login was not allowed."
msgstr "Nie zezwolono na uruchamianie po zalogowaniu."

#: openexpress/background.py
#, python-brace-format
msgid "Sync the device with Garmin Connect when it is connected."
msgstr "Synchronizacja urządzenia z Garmin Connect po jego podłączeniu."

#. TRANSLATORS: why background sync could not be turned on in the Flatpak: the desktop's
#. portal has no Background service; "the version from source" is openExpress installed from
#. its source code, which runs in the background without the portal
#: openexpress/background.py
#, python-brace-format
msgid ""
"This desktop does not let Flatpak apps run in the background (its portal has "
"no Background service). Use the version from source to sync in the "
"background."
msgstr ""
"To środowisko graficzne nie pozwala aplikacjom Flatpak działać w tle (jego "
"portal nie ma usługi Background). Użyj wersji ze źródeł, aby synchronizować "
"w tle."

#: openexpress/background.py
#, python-brace-format
msgid "systemctl was not found; background sync needs systemd."
msgstr "Nie znaleziono systemctl; synchronizacja w tle wymaga systemd."

#: openexpress/backup.py
#, python-brace-format
msgid ""
"Nothing was backed up: the device names a folder or file “{name}” that "
"cannot be used as a path on this computer."
msgstr ""
"Nie zrobiono kopii zapasowej: urządzenie podaje folder lub plik „{name}”, "
"którego nie można użyć jako ścieżki na tym komputerze."

#. TRANSLATORS: after a backup (a message of the window and a line of the command line)
#: openexpress/backup.py
#, python-brace-format
msgid ""
"{count} file was still being written by the device and is not in the backup. "
"Unplug the device and plug it in again, then make the backup again."
msgid_plural ""
"{count} files were still being written by the device and are not in the "
"backup. Unplug the device and plug it in again, then make the backup again."
msgstr[0] ""
"{count} plik był jeszcze zapisywany przez urządzenie i nie trafił do kopii. "
"Odłącz urządzenie i podłącz je ponownie, a potem zrób kopię jeszcze raz."
msgstr[1] ""
"{count} pliki były jeszcze zapisywane przez urządzenie i nie trafiły do "
"kopii. Odłącz urządzenie i podłącz je ponownie, a potem zrób kopię jeszcze "
"raz."
msgstr[2] ""
"{count} plików było jeszcze zapisywanych przez urządzenie i nie trafiło do "
"kopii. Odłącz urządzenie i podłącz je ponownie, a potem zrób kopię jeszcze "
"raz."

#. TRANSLATORS: a step of a backup ("… · 120 of 1530")
#: openexpress/backup.py
#, python-brace-format
msgid "Copying to the backup"
msgstr "Kopiowanie do kopii zapasowej"

