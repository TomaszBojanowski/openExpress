msgstr "{service} ({host}): {detail}"

#: openexpress/ownmaps.py
#, python-brace-format
msgid "Rename the file on your computer and add it again."
msgstr "Zmień nazwę pliku na komputerze i dodaj go ponownie."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "Choose another name with --name."
msgstr "Wybierz inną nazwę przez --name."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "Choose another one with --name."
msgstr "Wybierz inną przez --name."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "This device has no folder for maps."
msgstr "To urządzenie nie ma folderu na mapy."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "{name} is named like one of Garmin's own maps, so it is not removed."
msgstr ""
"Plik {name} ma nazwę taką jak mapy Garmina, więc nie zostanie usunięty."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "{file} is not a Garmin map file (.img)."
msgstr "{file} nie jest plikiem mapy Garmin (.img)."

