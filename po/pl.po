#: openexpress/settings.py:135
#, python-brace-format
msgid "Unknown environment: {name}"
msgstr "Nieznane środowisko: {name}"

#: openexpress/settings.py:170
msgid ""
"openExpress is not set up yet. It needs the Garmin Express installer for "
"Windows (GarminExpress.exe, a free download from garmin.com), and only reads "
"it: it takes Garmin Express's application key from it, so no key needs to be "
"created in Garmin Connect. First run: openexpress setup --from-installer /"
"path/to/GarminExpress.exe"
msgstr ""
"openExpress nie jest jeszcze skonfigurowany. Potrzebuje instalatora Garmin "
"Express dla Windows (GarminExpress.exe, do pobrania za darmo z garmin.com) "
"i tylko go odczytuje: bierze z niego klucz aplikacji Garmin Express, więc "
"w Garmin Connect nie trzeba tworzyć żadnego klucza. Najpierw uruchom: "
"openexpress setup --from-installer /ścieżka/do/GarminExpress.exe"

#: openexpress/settings.py:180
#, python-brace-format
msgid ""
"The saved client key in {path} is damaged. Run again: openexpress setup --"
"from-installer /path/to/GarminExpress.exe"
msgstr ""
"Zapisany klucz aplikacji w {path} jest uszkodzony. Uruchom ponownie: "
"openexpress setup --from-installer /ścieżka/do/GarminExpress.exe"

