#. TRANSLATORS: subtitle of "Memory Dumps" when the device holds none
#: openexpress/gui/status_page.py
#, python-brace-format
msgctxt "dumps"
msgid "None"
msgstr "Brak"

#. TRANSLATORS: subtitle of "Memory Dumps": how many memory dump files the device holds
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "{count} dump"
msgid_plural "{count} dumps"
msgstr[0] "{count} zrzut"
msgstr[1] "{count} zrzuty"
msgstr[2] "{count} zrzutów"

#. TRANSLATORS: of the memory dumps of the device: only Garmin can read them; plural,
#. as "dumps"
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "encrypted"
msgstr "zawartość zaszyfrowana"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Copy Memory Dumps"
msgstr "Skopiuj zrzuty pamięci"

#. TRANSLATORS: a button of the rows "Crash Logs" and "Memory Dumps" on the page Device
#. Status: copies them to this computer (the row says what); short, for a narrow window
#: openexpress/gui/status_page.py
#, python-brace-format
msgctxt "copy diagnostic files"
msgid "Copy"
msgstr "Skopiuj"

#. TRANSLATORS: in the subtitle of "Memory Dumps" of a device not connected: the dumps were
#. counted at its last connection, e.g. "6 dumps · 54.0 MB · at the last connection"
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "at the last connection"
msgstr "przy ostatnim podłączeniu"

#. TRANSLATORS: group of the page Device Status
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Report a Problem"
msgstr "Zgłoszenie problemu"

#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"The device, the system and the recent crashes; no serial number, Unit ID or "
"e-mail"
msgstr ""
"Urządzenie, system i ostatnie awarie; bez numeru seryjnego, Unit ID i e-maila"

#. TRANSLATORS: button that opens the report of the device (a dialog with more to do)
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Report…"
msgstr "Zgłoś…"

#. TRANSLATORS: in the subtitle of the row "Device Status" of a device not connected: when
