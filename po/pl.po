msgstr "OUT.BIN nie zawiera odpowiedzi z listą zainstalowanych aplikacji"

#: openexpress/ciq.py:187
#, python-brace-format
msgid "The Connect IQ app list (OUT.BIN) is damaged: {error}"
msgstr "Lista aplikacji Connect IQ (OUT.BIN) jest uszkodzona: {error}"

