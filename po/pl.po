#: openexpress/applog.py:357
#, python-brace-format
msgid "No log file: {error}"
msgstr "Brak pliku logu: {error}"

#: openexpress/auth/sso.py:240
msgid "The sign-in page stopped working"
msgstr "Strona logowania przestała działać"

#: openexpress/auth/sso.py:243
msgid ""
"Try again, or sign in without this window: run this command in a terminal, "
"sign in in your web browser and paste the address you end up on."
msgstr ""
"Spróbuj ponownie albo zaloguj się bez tego okna: uruchom to polecenie "
"w terminalu, zaloguj się w przeglądarce i wklej adres, na którym skończysz."

#: openexpress/auth/sso.py:253 openexpress/gui/app.py:2561
#: openexpress/gui/app.py:3769 openexpress/gui/netstatus_view.py:139
msgid "Try Again"
msgstr "Spróbuj ponownie"

#: openexpress/auth/sso.py:283
msgid "Sign in to Garmin"
msgstr "Zaloguj się do Garmin"

#: openexpress/auth/sso.py:359
msgid "Login cancelled or no SSO ticket received."
msgstr "Anulowano logowanie lub nie otrzymano biletu SSO."

#: openexpress/auth/sso.py:365
msgid "1. Open this URL in your browser:"
msgstr "1. Otwórz ten adres URL w przeglądarce:"

#: openexpress/auth/sso.py:367
msgid ""
"2. Sign in. Afterwards, copy the full URL from the browser's address bar\n"
"   (it contains 'ticket=ST-...'). If the browser shows an error, the URL "
"still works."
msgstr ""
"2. Zaloguj się. Następnie skopiuj pełny adres URL z paska adresu "
"przeglądarki\n"
"   (zawiera „ticket=ST-...”). Jeśli przeglądarka pokaże błąd, adres URL "
"nadal działa."

#: openexpress/auth/sso.py:370
msgid "3. Paste the URL: "
msgstr "3. Wklej adres URL: "

#: openexpress/auth/sso.py:373
msgid "The given URL has no ticket=ST-... parameter"
msgstr "Podany adres URL nie zawiera parametru ticket=ST-..."

#: openexpress/auth/store.py:27
msgid "(unknown account)"
msgstr "(nieznane konto)"

#: openexpress/auth/store.py:37
msgid "Not logged in. Run: openexpress login"
msgstr "Nie zalogowano. Uruchom: openexpress login"

#: openexpress/auth/store.py:42 openexpress/auth/store.py:45
msgid "The saved login is damaged; please log in again."
msgstr "Zapisane logowanie jest uszkodzone; zaloguj się ponownie."

#: openexpress/background.py:65
msgid "Background sync was not allowed."
msgstr "Nie zezwolono na synchronizację w tle."

#: openexpress/background.py:67
msgid "Starting at login was not allowed."
msgstr "Nie zezwolono na uruchamianie po zalogowaniu."

#: openexpress/background.py:76
msgid "Sync the device with Garmin Connect when it is connected."
msgstr "Synchronizacja urządzenia z Garmin Connect po jego podłączeniu."

#: openexpress/background.py:120
msgid "systemctl was not found; background sync needs systemd."
msgstr "Nie znaleziono systemctl; synchronizacja w tle wymaga systemd."

#: openexpress/backup.py:59
#, python-brace-format
msgid ""
"Nothing was backed up: the device names a folder or file '{name}' that "
"cannot be used as a path on this computer."
msgstr ""
"Nie zrobiono kopii zapasowej: urządzenie podaje folder lub plik '{name}', "
"którego nie można użyć jako ścieżki na tym komputerze."

#. TRANSLATORS: the parts of the cache, as `openexpress cache` and the preferences list them
#: openexpress/cache.py:29
msgid "Maps"
msgstr "Mapy"

#: openexpress/cache.py:29
msgid "Software updates"
msgstr "Aktualizacje oprogramowania"

#: openexpress/cache.py:30
msgid "Pictures and icons"
msgstr "Zdjęcia i ikony"

#: openexpress/cache.py:30
msgid "Temporary files"
msgstr "Pliki tymczasowe"

#: openexpress/cache.py:67
msgid ""
"The cache is in use (a download or an install is running). Try again later."
msgstr ""
"Pamięć podręczna jest w użyciu (trwa pobieranie albo instalacja). Spróbuj "
"ponownie później."

#: openexpress/cache.py:143
#, python-brace-format
msgid "Could not delete {path}: {error}"
msgstr "Nie udało się usunąć {path}: {error}"

