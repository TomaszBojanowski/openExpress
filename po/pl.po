#, python-brace-format
msgid "as of {when}"
msgstr "stan z {when}"

#. TRANSLATORS: banner on top of the page Device Status of a device not connected: what
#. it shows is from its records, as of its last connection
#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"Not connected – as of {when}; connect it to free up space or copy diagnostic "
"files"
msgstr ""
"Niepodłączone – stan z {when}; podłącz je, aby zwolnić miejsce lub skopiować "
"pliki diagnostyczne"

#. TRANSLATORS: banner on top of the page Device Status of a device not connected whose
#. last connection is not known
#: openexpress/gui/status_page.py
#, python-brace-format
msgid "Not connected – connect it to free up space or copy diagnostic files"
msgstr ""
"Niepodłączone – podłącz je, aby zwolnić miejsce lub skopiować pliki "
"diagnostyczne"

#. TRANSLATORS: Device Status of a device without error logs or memory dumps openExpress
#. reads, while the storage card counts some of its files under {category} (the name of
#. that category on the card); {size}: e.g. 210.3 kB
#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"This device keeps no error logs or memory dumps that openExpress can read. "
"Its other diagnostic files ({size}) are counted under “{category}”."
msgstr ""
"To urządzenie nie zapisuje dzienników błędów ani zrzutów pamięci, które "
"openExpress potrafi odczytać. Jego pozostałe pliki diagnostyczne ({size}) są "
"liczone w kategorii „{category}”."

#. TRANSLATORS: the page Device Status of a device that keeps no diagnostic data
#: openexpress/gui/status_page.py
#, python-brace-format
msgid ""
"This device keeps no error logs or memory dumps that openExpress can read"
msgstr ""
"To urządzenie nie zapisuje dzienników błędów ani zrzutów pamięci, które "
"openExpress potrafi odczytać"

#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "{count} activity on the device has not been uploaded yet."
msgid_plural "{count} activities on the device have not been uploaded yet."
msgstr[0] "{count} aktywność na urządzeniu nie została jeszcze wysłana."
msgstr[1] "{count} aktywności na urządzeniu nie zostały jeszcze wysłane."
msgstr[2] "{count} aktywności na urządzeniu nie zostało jeszcze wysłanych."

#. TRANSLATORS: subtitle of an update on the Updates page that openExpress does not install,
#. without a full stop; {folder}: the folder of the device's top level its file goes to
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid ""
"Cannot be installed: openExpress cannot see its folder {folder} on this "
"device"
msgstr ""
"Nie do zainstalowania: openExpress nie widzi na tym urządzeniu jego folderu "
"{folder}"

#. TRANSLATORS: on the Updates page, under the device's software that openExpress does not
#. install; {folder}: the folder of the device's top level, e.g. .System
#: openexpress/gui/updates_page.py
#, python-brace-format
msgctxt "updates page"
msgid ""
"openExpress cannot see the folder {folder}, where this device keeps its "
"software, so it installs nothing there. Some devices, such as car "
"navigators, hide it from the file manager."
msgstr ""
"openExpress nie widzi folderu {folder}, w którym to urządzenie trzyma swoje "
"oprogramowanie, więc niczego tam nie instaluje. Niektóre urządzenia, np. "
"nawigacje samochodowe, ukrywają go przed menedżerem plików."

#. TRANSLATORS: in the question before an update whose file is on the device where the file
#. manager does not see it (in a folder or as a file the device hides): the new file takes the
#. place of the one of its name; {file}: e.g. gmaptz.img
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "The update replaces the file {file} on the device."
msgstr "Aktualizacja zastąpi plik {file} na urządzeniu."

#. TRANSLATORS: title of the Updates page when updates are offered and openExpress can install
#. none of them on this device
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "Update Cannot Be Installed"
msgid_plural "Updates Cannot Be Installed"
msgstr[0] "Nie można zainstalować aktualizacji"
msgstr[1] "Nie można zainstalować aktualizacji"
msgstr[2] "Nie można zainstalować aktualizacji"

#. TRANSLATORS: on the Updates page; {folder}: a folder the device hides from the
#. file manager, e.g. .System
#: openexpress/gui/updates_page.py
#, python-brace-format
msgctxt "updates page"
msgid ""
"The Flatpak version has no access to USB devices, so it cannot read the "
"folder {folder}. Give it the permission (see the README) or use the version "
"from source."
msgstr ""
"Wersja Flatpak nie ma dostępu do urządzeń USB, więc nie może odczytać "
"folderu {folder}. Nadaj jej to uprawnienie (patrz README) albo użyj wersji "
"ze źródeł."

#. TRANSLATORS: on the Updates page, a line under its heading, without a full stop: the
#. connection could be opened, but the folder could not be read this time (e.g. the device
#. was busy); {folder}: a folder the device hides from the file manager, e.g. .System;
#. {button}: the name of the button Check Again of this page
#: openexpress/gui/updates_page.py
#, python-brace-format
msgctxt "updates page"
msgid ""
"openExpress could not read the folder {folder} this time; use “{button}” to "
"try once more"
msgstr ""
"openExpress nie odczytał tym razem folderu {folder}; użyj przycisku "
"„{button}”, aby spróbować jeszcze raz"

#. TRANSLATORS: on the Updates page, a line under its heading, without a full stop;
#. {folder}: a folder the device hides from the file manager, e.g. .System
#: openexpress/gui/updates_page.py
#, python-brace-format
msgctxt "updates page"
msgid ""
"openExpress cannot open a direct USB connection to this device, so it cannot "
"read the folder {folder}"
msgstr ""
"openExpress nie może otworzyć bezpośredniego połączenia USB z tym "
"urządzeniem, więc nie odczyta folderu {folder}"

#. TRANSLATORS: subtitle of the row "Add-Ons" on the Updates page: items Garmin offers to
#. add to the device (voices, vehicles) that it does not have, without a full stop
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid ""
"{count} add-on that is not on the device; openExpress does not install add-"
"ons yet"
msgid_plural ""
"{count} add-ons that are not on the device; openExpress does not install add-"
"ons yet"
msgstr[0] ""
"{count} dodatek, którego nie ma na urządzeniu; openExpress jeszcze nie "
"instaluje dodatków"
msgstr[1] ""
"{count} dodatki, których nie ma na urządzeniu; openExpress jeszcze nie "
"instaluje dodatków"
msgstr[2] ""
"{count} dodatków, których nie ma na urządzeniu; openExpress jeszcze nie "
"instaluje dodatków"

#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "License Agreement (EULA)"
msgstr "Umowa licencyjna (EULA)"

#. TRANSLATORS: heading of the message after some of the updates were copied and
#. others were not (the list says which and why)
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "Not All Updates Installed"
msgstr "Nie zainstalowano wszystkich aktualizacji"

#. TRANSLATORS: heading of the error message when installing an update failed
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid "Update Not Installed"
msgstr "Nie zainstalowano aktualizacji"

#. TRANSLATORS: the note of a group on the Updates page: updates whose folder the device
#. hides from the file manager, which openExpress writes only over a direct USB connection
#. and cannot open to this device; the rows say it in short
#: openexpress/gui/updates_page.py
#, python-brace-format
msgid ""
"{count} of these cannot be installed: the device keeps it in a folder it "
"hides from the file manager, and openExpress cannot open a direct USB "
"connection to this device (the Flatpak version needs access to USB devices "
"for it, see the README). The others install as usual."
msgid_plural ""
"{count} of these cannot be installed: the device keeps them in folders it "
"hides from the file manager, and openExpress cannot open a direct USB "
"connection to this device (the Flatpak version needs access to USB devices "
"for it, see the README). The others install as usual."
msgstr[0] ""
"{count} z nich nie można zainstalować: urządzenie trzyma ją w folderze "
"ukrytym przed menedżerem plików, a openExpress nie może otworzyć "
"bezpośredniego połączenia USB z tym urządzeniem (wersja Flatpak potrzebuje "
"do tego dostępu do urządzeń USB, patrz README). Pozostałe instalują się "
"normalnie."
msgstr[1] ""
"{count} z nich nie można zainstalować: urządzenie trzyma je w folderach "
