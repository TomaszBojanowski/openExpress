"The incomplete file could not be removed; delete {path} from the device "
"yourself."
msgstr ""
"Niepełnego pliku nie udało się usunąć; usuń {path} z urządzenia ręcznie."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"Writing {path} failed and the incomplete file could not be removed; delete "
"{path} from the device yourself."
msgstr ""
"Zapis {path} się nie powiódł, a niepełnego pliku nie udało się usunąć; usuń "
"{path} z urządzenia ręcznie."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "Writing {path} failed; the incomplete file was removed from the device."
msgstr "Zapis {path} się nie powiódł; niepełny plik usunięto z urządzenia."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"{name} on the device has {actual}, but the map that was copied had "
"{expected}: it is not the same file, so it is not removed."
msgstr ""
"Plik {name} na urządzeniu ma {actual}, a skopiowana mapa miała {expected}: "
"to nie ten sam plik, więc nie zostanie usunięty."

