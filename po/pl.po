msgstr ""
"Plik {name} zmienił się od wyświetlenia listy, więc nie zostanie usunięty."

#. TRANSLATORS: what was chosen to be removed is not a course's file or a waiting GPX
#. file of the device's folders
#: openexpress/courses.py
#, python-brace-format
msgid "{name} is not the file of a course, so it is not removed."
msgstr "{name} nie jest plikiem kursu, więc nie zostanie usunięty."

#: openexpress/courses.py
msgid "The device has not made a course of it yet."
msgstr "Urządzenie nie zrobiło jeszcze z niego kursu."

#: openexpress/courses.py
msgid "The device keeps no other copy of it."
msgstr "Urządzenie nie ma innej kopii tego kursu."

#: openexpress/courses.py
msgid "The device keeps no other copy of it; Garmin Connect can send it again."
msgstr ""
"Urządzenie nie ma innej kopii tego kursu; Garmin Connect może wysłać go "
"ponownie."

#: openexpress/courses.py
msgid ""
"openExpress did not copy this course and it did not come from Garmin "
"Connect. The device keeps no other copy of it."
msgstr ""
"openExpress nie skopiował tego kursu i nie pochodzi on z Garmin Connect. "
"Urządzenie nie ma innej kopii tego kursu."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "{path} is still on the device."
msgstr "Plik {path} nadal jest na urządzeniu."

#. TRANSLATORS: name of the hidden desktop entry that syncs in the background when the device is
#. connected
#: openexpress/desktop.py
msgid "openExpress (background)"
msgstr "openExpress (w tle)"

#. TRANSLATORS: generic name of the app in application menus (GenericName in the desktop file): a
#. tool that syncs Garmin devices
#: openexpress/desktop.py
msgid "Garmin Device Sync"
msgstr "Synchronizacja urządzeń Garmin"

#: openexpress/desktop.py
msgid "Sync, updates and maps for Garmin devices"
msgstr "Synchronizacja, aktualizacje i mapy dla urządzeń Garmin"

#. TRANSLATORS: search keywords for the application menu; keep the ";" separators and the ending ";"
#: openexpress/desktop.py
msgid "Garmin;Fenix;Connect;sync;"
msgstr "Garmin;Fenix;Connect;sync;synchronizacja;zegarek;"

