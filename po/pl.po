"{file} has only waypoints: no course is made of it, so it takes no course "
"name."
msgstr ""
"{file} zawiera tylko punkty: urządzenie nie zrobi z niego kursu, więc nie "
"można nadać mu nazwy kursu."

#. TRANSLATORS: `courses add FILE --name NAME` for a GPX file of several tracks and routes,
#. each of which the device makes a course of, with the name it has
#: openexpress/courses.py
#, python-brace-format
msgid ""
"{file} makes {count} course; only a file with one track or route takes a "
"course name."
msgid_plural ""
"{file} makes {count} courses; only a file with one track or route takes a "
"course name."
msgstr[0] ""
"Z pliku {file} urządzenie zrobi {count} kurs; nazwę kursu można nadać tylko "
"plikowi z jednym śladem lub trasą."
msgstr[1] ""
"Z pliku {file} urządzenie zrobi {count} kursy; nazwę kursu można nadać tylko "
"plikowi z jednym śladem lub trasą."
msgstr[2] ""
"Z pliku {file} urządzenie zrobi {count} kursów; nazwę kursu można nadać "
"tylko plikowi z jednym śladem lub trasą."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "A file named {name} is already on the device; nothing is overwritten."
msgstr ""
"Plik o nazwie {name} jest już na urządzeniu; nic nie zostanie nadpisane."

#: openexpress/courses.py
#, python-brace-format
msgid "The device makes the course when you unplug the cable."
msgid_plural "The device makes {count} courses when you unplug the cable."
msgstr[0] "Urządzenie utworzy kurs po odłączeniu kabla."
msgstr[1] "Urządzenie utworzy {count} kursy po odłączeniu kabla."
msgstr[2] "Urządzenie utworzy {count} kursów po odłączeniu kabla."

#: openexpress/courses.py
msgid ""
"Garmin devices join the points of a route with straight lines, not roads. "
"For a course along roads, export a track instead of a route."
msgstr ""
"Urządzenia Garmina łączą punkty trasy prostymi odcinkami, nie drogami. Jeśli "
"chcesz kurs po drogach, wyeksportuj ślad zamiast trasy."

#: openexpress/courses.py
msgid "Garmin devices save waypoints as saved locations."
msgstr "Urządzenia Garmina zapisują punkty jako zapisane lokalizacje."

#. TRANSLATORS: a device that does not take GPX files in Garmin/NewFiles
#: openexpress/courses.py
msgid "This device does not make courses of GPX files."
msgstr "To urządzenie nie tworzy kursów z plików GPX."

#. TRANSLATORS: {folder}: a folder the device declares, such as Garmin/NewFiles
#: openexpress/courses.py
#, python-brace-format
msgid "The device has no folder {folder}."
msgstr "Na urządzeniu nie ma katalogu {folder}."

#. TRANSLATORS: copying a map file to the device failed; {path}: the file's path on the
#. device
#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "Writing {path} failed."
msgstr "Zapis {path} się nie powiódł."

#: openexpress/courses.py openexpress/ownmaps.py
#, python-brace-format
msgid "{name} is no longer on the device."
msgstr "Pliku {name} nie ma już na urządzeniu."

