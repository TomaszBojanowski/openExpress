msgstr "--key i --secret trzeba podać razem"

#: openexpress/cli.py:3425
msgid ""
"openExpress needs PyGObject with GTK 4 and libadwaita. Install them (Fedora: "
"sudo dnf install python3-gobject gtk4 libadwaita; Arch: sudo pacman -S "
"python-gobject gtk4 libadwaita; Debian and Ubuntu: sudo apt install python3-"
"gi gir1.2-gtk-4.0 gir1.2-adw-1), then run the command again."
msgstr ""
"openExpress potrzebuje PyGObject z GTK 4 i libadwaita. Zainstaluj je "
"(Fedora: sudo dnf install python3-gobject gtk4 libadwaita; Arch: sudo pacman "
"-S python-gobject gtk4 libadwaita; Debian i Ubuntu: sudo apt install python3-"
"gi gir1.2-gtk-4.0 gir1.2-adw-1), a potem uruchom polecenie ponownie."

