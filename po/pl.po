#: openexpress/connect.py
#, ignore-reused
msgctxt "server request"
msgid "Primary wearable"
msgstr "Podstawowe urządzenie typu wearable"

#: openexpress/connect.py
msgid "Adding the device to the account"
msgstr "Dodawanie urządzenia do konta"

#: openexpress/connect.py
msgid ""
"Garmin did not accept the description of this device. Nothing was changed."
msgstr "Garmin nie przyjął opisu tego urządzenia. Niczego nie zmieniono."

#: openexpress/connect.py
msgid ""
"Garmin does not allow adding this device to an account. Nothing was changed."
msgstr ""
"Garmin nie pozwala dodać tego urządzenia do konta. Niczego nie zmieniono."

#: openexpress/connect.py
msgid ""
"Garmin accepted the request, but its answer names another device. Check the "
"devices of your account in Garmin Connect."
msgstr ""
"Garmin przyjął zapytanie, ale jego odpowiedź dotyczy innego urządzenia. "
"Sprawdź urządzenia swojego konta w Garmin Connect."

#: openexpress/connect.py
msgid ""
"Another Garmin account has an active subscription on this device; its owner "
"has to end it first. Nothing was changed."
msgstr ""
"Inne konto Garmin ma aktywną subskrypcję na tym urządzeniu; jej właściciel "
"musi ją najpierw zakończyć. Niczego nie zmieniono."

#: openexpress/connect.py
msgid ""
"This device is registered to another Garmin account. If it is your other "
"account, sign in to it in openExpress. If it was someone else's, they have "
"to remove it from their account in Garmin Connect; then add it here. Nothing "
"was changed."
msgstr ""
"To urządzenie jest zarejestrowane na innym koncie Garmin. Jeśli to Twoje "
"drugie konto, zaloguj się na nie w openExpress. Jeśli należało do kogoś "
"innego, ta osoba musi usunąć je ze swojego konta w Garmin Connect; potem "
"dodaj je tutaj. Niczego nie zmieniono."

#: openexpress/connect.py
msgid "Making the device active"
msgstr "Ustawianie urządzenia jako aktywnego"

