#: openexpress/ownmaps.py
msgid "Rename the file on your computer and add it again."
msgstr ""
"Benennen Sie die Datei auf Ihrem Computer um und fügen Sie sie erneut hinzu."

#: openexpress/ownmaps.py
msgid "Choose another name with --name."
msgstr "Wählen Sie mit --name einen anderen Namen."

#: openexpress/ownmaps.py
msgid "Choose another one with --name."
msgstr "Wählen Sie mit --name einen anderen."

#: openexpress/ownmaps.py
msgid "This device has no folder for maps."
msgstr "Dieses Gerät hat keinen Ordner für Karten."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "{name} is named like one of Garmin's own maps, so it is not removed."
msgstr ""
"{name} ist wie eine von Garmins eigenen Karten benannt, daher wird sie nicht "
"entfernt."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "{file} is not a Garmin map file (.img)."
msgstr "{file} ist keine Garmin-Kartendatei (.img)."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"The name {name} cannot be used: only letters, digits, spaces and . _ - ( ) "
"are allowed, and it must end with .img."
msgstr ""
"Der Name {name} kann nicht verwendet werden: Nur Buchstaben, Ziffern, "
"Leerzeichen und . _ - ( ) sind erlaubt, und er muss auf .img enden."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "The name {name} is reserved for Garmin's own maps."
msgstr "Der Name {name} ist für Garmins eigene Karten reserviert."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"Writing {path} failed and the incomplete file could not be removed; delete "
"{path} from the device yourself."
msgstr ""
"Das Schreiben von {path} ist fehlgeschlagen und die unvollständige Datei "
"konnte nicht entfernt werden; löschen Sie {path} selbst vom Gerät."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "Writing {path} failed; the incomplete file was removed from the device."
msgstr ""
"Das Schreiben von {path} ist fehlgeschlagen; die unvollständige Datei wurde "
"vom Gerät entfernt."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"{name} on the device has {actual}, but the map that was copied had "
"{expected}: it is not the same file, so it is not removed."
msgstr ""
"{name} auf dem Gerät hat {actual}, aber die kopierte Karte hatte {expected}: "
"Es ist nicht dieselbe Datei, daher wird sie nicht entfernt."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"{name} was not copied to the device by this installation of openExpress (it "
"may have been copied by hand or by another installation), so it is not "
"removed. Delete it in the file manager if you want it gone."
msgstr ""
"{name} wurde nicht von dieser Installation von openExpress auf das Gerät "
"kopiert (vielleicht von Hand oder von einer anderen Installation), daher "
"wird sie nicht entfernt. Löschen Sie sie in der Dateiverwaltung, wenn sie "
"weg soll."

#: openexpress/ownmaps.py
#, python-brace-format
msgid ""
"{name} has changed since the list was shown (another size or another map "
"name inside), so it is not removed."
msgstr ""
"{name} hat sich geändert, seit die Liste angezeigt wurde (andere Größe oder "
"anderer Kartenname darin), daher wird sie nicht entfernt."

#: openexpress/ownmaps.py
#, python-brace-format
msgid "{path} is still on the device; nothing was taken off the list."
msgstr "{path} ist noch auf dem Gerät; nichts wurde aus der Liste genommen."

#. TRANSLATORS: how far a step of a long task is: "3 of 8", "412.0 MB of 1.5 GB"
#: openexpress/progress.py
#, python-brace-format
msgid "{done} of {total}"
msgstr "{done} von {total}"

#. TRANSLATORS: a step of a long task: an update, a map, an app or TrueUp downloaded
#. ("… · 1.2 MB of 3.4 MB", "… · 1 of 2")
#: openexpress/progress.py
#, python-brace-format
msgid "Downloading {name}"
msgstr "{name} wird heruntergeladen"

#. TRANSLATORS: a step of a long task: an update or a map copied to the device
#. ("… · 1.2 MB of 3.4 MB")
#: openexpress/progress.py
#, python-brace-format
msgid "Copying {name} to the device"
msgstr "{name} wird auf das Gerät kopiert"

#. TRANSLATORS: a step of a long task: an app or TrueUp written to the device ("… · 1 of 2")
#: openexpress/progress.py
#, python-brace-format
msgid "Writing {name} to the device"
msgstr "{name} wird auf das Gerät geschrieben"

#. TRANSLATORS: a step of a long task: an update or a map read back from a USB drive after
#. its copy and compared with what was written ("… · 1.2 MB of 3.4 MB")
#: openexpress/progress.py
#, python-brace-format
msgid "Checking {name} on the device"
msgstr "{name} wird auf dem Gerät geprüft"

