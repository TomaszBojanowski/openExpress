msgstr "Die Dateien des Geräts werden aktualisiert…"

#. TRANSLATORS: error reading protobuf data (the device's Connect IQ files): it ends
#. inside a varint, a variable-length number
#: openexpress/proto.py
msgid "Truncated varint"
msgstr "Abgeschnittener Varint"

#. TRANSLATORS: error reading protobuf data (the device's Connect IQ files): a varint, a
#. variable-length number, longer than 64 bits
#: openexpress/proto.py
msgid "Varint too long"
msgstr "Varint zu lang"

#: openexpress/proto.py
msgid "Invalid field number 0"
msgstr "Ungültige Feldnummer 0"

#. TRANSLATORS: error reading protobuf data (the device's Connect IQ files): a field
#. with a given length runs past the end of the data
#: openexpress/proto.py
msgid "Truncated length-delimited field"
msgstr "Abgeschnittenes längenbegrenztes Feld"

#. TRANSLATORS: error reading protobuf data (the device's Connect IQ files): a 4- or
#. 8-byte field runs past the end of the data
#: openexpress/proto.py
msgid "Truncated fixed-size field"
msgstr "Abgeschnittenes Feld fester Größe"

#: openexpress/proto.py
#, python-brace-format
msgid "Unsupported wire type {type}"
msgstr "Nicht unterstützter Wire-Typ {type}"

#: openexpress/service.py
#, python-brace-format
msgid ""
"The token is for environment {token_environment}, but the configured one is "
"{environment}. Sign in again."
msgstr ""
"Das Token gilt für die Umgebung {token_environment}, eingestellt ist aber "
"{environment}. Melden Sie sich erneut an."

#: openexpress/service.py
msgid ""
"This device is connected as a USB drive and declares no data that goes from "
"it to Garmin Connect, so there is nothing to sync."
msgstr ""
"Dieses Gerät ist als USB-Laufwerk angeschlossen und gibt keine Daten an, die "
"von ihm zu Garmin Connect gehen, daher gibt es nichts zu synchronisieren."

#. TRANSLATORS: "connect support: Disabled" is what Garmin's server says; keep it as it is
#: openexpress/service.py
msgid ""
"This device is connected as a USB drive, and Garmin's server says that "
"Garmin Connect does not take its data (connect support: Disabled), so it is "
"not synced."
msgstr ""
"Dieses Gerät ist als USB-Laufwerk angeschlossen, und Garmins Server gibt an, "
"dass Garmin Connect seine Daten nicht annimmt (connect support: Disabled), "
"daher wird es nicht synchronisiert."

#: openexpress/service.py
#, python-brace-format
msgid ""
"This device is connected as a USB drive, and Garmin's server could not be "
"asked whether Garmin Connect takes its data, so it is not synced: {error}"
msgstr ""
"Dieses Gerät ist als USB-Laufwerk angeschlossen, und Garmins Server konnte "
"nicht gefragt werden, ob Garmin Connect seine Daten annimmt, daher wird es "
"nicht synchronisiert: {error}"

#: openexpress/service.py
msgid ""
"Several Garmin devices are connected as USB drives. Connect only one of them."
msgstr ""
"Mehrere Garmin-Geräte sind als USB-Laufwerke angeschlossen. Schließen Sie "
"nur eines davon an."

#: openexpress/service.py
#, python-brace-format
msgid ""
"Could not check whether this device belongs to your Garmin account "
"({error}). Nothing was synced."
msgstr ""
"Es konnte nicht geprüft werden, ob dieses Gerät zu Ihrem Garmin-Konto gehört "
"({error}). Nichts wurde synchronisiert."

#: openexpress/service.py
msgid ""
"This device is not registered to your Garmin account. To use it with Garmin "
"Connect here, sign in to the account it belongs to, or add the device to "
"your account: here (Add to Account in the window, openexpress register on "
"the command line; experimental) or in Garmin Connect (the phone app, or "
"connect.garmin.com); registering the product on garmin.com is not enough. If "
"it is added already, check that the Garmin Connect app on your phone and "
"openExpress are signed in to the same account."
msgstr ""
"Dieses Gerät ist nicht in Ihrem Garmin-Konto registriert. Um es hier mit "
"Garmin Connect zu verwenden, melden Sie sich bei dem Konto an, zu dem es "
"gehört, oder fügen Sie das Gerät Ihrem Konto hinzu: hier („Zum Konto "
"hinzufügen“ im Fenster, openexpress register auf der Befehlszeile; "
"experimentell) oder in Garmin Connect (in der Telefon-App oder auf "
"connect.garmin.com); die Produktregistrierung auf garmin.com reicht nicht "
"aus. Ist es bereits hinzugefügt, prüfen Sie, ob die Garmin Connect-App auf "
"Ihrem Telefon und openExpress beim selben Konto angemeldet sind."

#: openexpress/service.py
msgid ""
"the Garmin account has no consent to upload data from devices; turn it on in "
