msgid "Nothing was uploaded: {reason}"
msgstr "Nichts wurde hochgeladen: {reason}"

#: openexpress/service.py
#, python-brace-format
msgid "Nothing would be uploaded: {reason}"
msgstr "Nichts würde hochgeladen: {reason}"

