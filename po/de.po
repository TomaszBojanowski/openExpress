#: openexpress/auth/sso.py
msgid "Sign-In Page Not Working"
msgstr "Anmeldeseite funktioniert nicht"

#: openexpress/auth/sso.py
msgid ""
"Try again, or sign in without this window: run this command in a terminal, "
"sign in in your web browser, then paste the address the browser shows at the "
"end."
msgstr ""
"Versuchen Sie es erneut oder melden Sie sich ohne dieses Fenster an: Führen "
"Sie diesen Befehl in einem Terminal aus, melden Sie sich im Webbrowser an "
"und fügen Sie dann die Adresse ein, die der Browser am Ende anzeigt."

#: openexpress/auth/sso.py openexpress/gui/device_page.py
#: openexpress/gui/netstatus_view.py openexpress/gui/updates_page.py
msgid "Try Again"
msgstr "Erneut versuchen"

#: openexpress/auth/sso.py
msgid "Sign in to Garmin"
msgstr "Bei Garmin anmelden"

#: openexpress/auth/sso.py
msgid "Sign-in cancelled or no SSO ticket received."
msgstr "Anmeldung abgebrochen oder kein SSO-Ticket erhalten."

#: openexpress/auth/sso.py
msgid "1. Open this URL in your browser:"
msgstr "1. Öffnen Sie diese URL in Ihrem Browser:"

#: openexpress/auth/sso.py
msgid ""
"2. Sign in. Afterwards, copy the full URL from the browser's address bar\n"
"   (it contains “ticket=ST-…”). If the browser shows an error, the URL still "
"works."
msgstr ""
"2. Melden Sie sich an. Kopieren Sie danach die vollständige URL aus der "
"Adressleiste des Browsers\n"
"   (sie enthält „ticket=ST-…“). Auch wenn der Browser einen Fehler anzeigt, "
"funktioniert die URL."

#: openexpress/auth/sso.py
msgid "3. Paste the URL: "
msgstr "3. Fügen Sie die URL ein: "

#: openexpress/auth/sso.py
msgid "The given URL has no ticket=ST-... parameter"
msgstr "Die angegebene URL hat keinen Parameter ticket=ST-..."

#. TRANSLATORS: shown in place of the signed-in Garmin account's name when it has no user
#. name and no e-mail address
#: openexpress/auth/store.py
msgid "(unknown account)"
msgstr "(unbekanntes Konto)"

#: openexpress/auth/store.py openexpress/connect.py
msgid "Not signed in. Run: openexpress login"
msgstr "Nicht angemeldet. Führen Sie aus: openexpress login"

#: openexpress/auth/store.py
msgid "The saved sign-in is damaged; sign in again."
msgstr "Die gespeicherte Anmeldung ist beschädigt; melden Sie sich erneut an."

#: openexpress/background.py
msgid "Background sync was not allowed."
msgstr "Die Synchronisierung im Hintergrund wurde nicht erlaubt."

#: openexpress/background.py
msgid "Starting at login was not allowed."
msgstr "Der Start bei der Anmeldung wurde nicht erlaubt."

#: openexpress/background.py
msgid "Sync the device with Garmin Connect when it is connected."
msgstr ""
"Das Gerät mit Garmin Connect synchronisieren, wenn es angeschlossen wird."

#: openexpress/background.py
msgid "systemctl was not found; background sync needs systemd."
msgstr ""
"systemctl wurde nicht gefunden; die Synchronisierung im Hintergrund benötigt "
"systemd."

#: openexpress/backup.py
#, python-brace-format
msgid ""
"Nothing was backed up: the device names a folder or file “{name}” that "
"cannot be used as a path on this computer."
msgstr ""
"Nichts wurde gesichert: Das Gerät nennt einen Ordner oder eine Datei "
"„{name}“, die auf diesem Computer nicht als Pfad verwendet werden kann."

#. TRANSLATORS: after a backup (a message of the window and a line of the command line)
#: openexpress/backup.py
#, python-brace-format
msgid ""
"{count} file was still being written by the device and is not in the backup. "
"Unplug the device and plug it in again, then make the backup again."
msgid_plural ""
"{count} files were still being written by the device and are not in the "
"backup. Unplug the device and plug it in again, then make the backup again."
msgstr[0] ""
"{count} Datei wurde noch vom Gerät geschrieben und ist nicht in der "
"Sicherung. Trennen Sie das Gerät, schließen Sie es wieder an und erstellen "
"Sie die Sicherung erneut."
msgstr[1] ""
"{count} Dateien wurden noch vom Gerät geschrieben und sind nicht in der "
"Sicherung. Trennen Sie das Gerät, schließen Sie es wieder an und erstellen "
"Sie die Sicherung erneut."

#. TRANSLATORS: a step of a backup ("… · 120 of 1530")
#: openexpress/backup.py
msgid "Copying to the backup"
msgstr "Kopieren in die Sicherung"

#. TRANSLATORS: the parts of the cache, as `openexpress cache` lists them
#. TRANSLATORS: rows of the cache in the preferences: downloaded maps
#: openexpress/cache.py openexpress/gui/preferences.py
msgid "Maps"
msgstr "Karten"

#. TRANSLATORS: a part of the cache in `openexpress cache`: downloaded device software
#: openexpress/cache.py
